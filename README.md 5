css
body {
  font-family: Arial, sans-serif;
  background-color: #f2f2f2;
  margin: 0;
  padding: 30px;
}

.box {
  background-color: white;
  max-width: 350px;
  margin: 0 auto;
  padding: 20px;
  border: 1px solid #ccc;
  border-radius: 5px;
}

h2 {
  margin-top: 0;
  color: #003366; /* Azul Uninassau */
  font-size: 20px;
}

p {
  font-size: 14px;
  color: #555;
}

input {
  width: 65%;
  padding: 8px;
  margin-top: 5px;
  border: 1px solid #ccc;
  border-radius: 3px;
}

button {
  padding: 8px 12px;
  background-color: #003366;
  color: white;
  border: none;
  border-radius: 3px;
  cursor: pointer;
}

button:hover {
  background-color: #002244;
}

.resultado {
  margin-top: 20px;
  background-color: #e6f0fa;
  padding: 10px;
  border: 1px solid #b8daff;
  border-radius: 4px;
}

.resultado p {
  margin: 5px 0;
  color: #333;
}

.preco {
  font-size: 16px;
  color: #27ae60 !important;
}
